# Olopa web backend
# Copy to .env and adjust

# App
APP_ENV=development
API_V1_PREFIX=/api/v1

# Database (SQLite for MVP; use DATABASE_URL for Postgres later)
DATABASE_URL=sqlite+aiosqlite:///./olopa_waitlist.db

# Optional: CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://olopa.io

# Rate limit: max waitlist signups per IP per hour
WAITLIST_RATE_LIMIT_PER_HOUR=5
