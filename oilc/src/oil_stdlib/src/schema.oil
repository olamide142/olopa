// OIL stdlib schema prelude.
// This file defines:
// 1) Runtime roots available without declaration (host, process, user, ...)
// 2) Entity/field contracts used by resolver and type-checking.

root host: Host
root process: Process
root user: User
root session: Session
root device: Device
root secure_connect: SecureConnectSession
root sc_profile: SecureConnectProfile
root sc_gateway: SecureConnectGateway
root sc_peer: SecureConnectPeer
root container: ContainerContext
root workload: WorkloadInfo
root network: NetworkFlow
root file: FileEvent
root dns: DnsQuery
root time: TimeContext

entity TimeContext {
    weekday: Str,
    hour: Int,
    minute: Int,
    is_business_hour: Bool,
}

entity Process {
    id: Int,
    pid: Int,
    ppid: Int,
    name: Str,
    tty: Bool,
    uid: Int,
    gid: Int,
    elevated: Bool,
    host_id: Str,
    container_id: Str?,
    command_line: Str?,
    parent: Process?,
    user: User?,
    binary: Binary?,
    session_id: Str?,
    secure_connect_session_id: Str?,
}

entity Binary {
    path: Path,
    filename: Path?,
    signed: Bool,
    hash: Str?,
}

entity Host {
    id: Str,
    hostname: Str?,
    risk_score: Float?,
    baseline: HostBaseline,
    device_id: Str?,
    secure_connect_enabled: Bool?,
}

entity HostBaseline {
    domains: Set<Str>,
    ips: Set<IpAddr>,
    processes: Set<Str>,
    users: Set<Str>,
}

entity BaselineProfile {
    allowed_processes: Set<Str>,
}

entity User {
    id: Str,
    uid: Int?,
    name: Str,
    groups: Set<Str>,
    trust_score: Float?,
    baseline: UserBaseline,
    last_known_device: Str?,
    secure_connect_groups: Set<Str>,
}

entity UserBaseline {
    countries: Set<Str>,
    hosts: Set<Str>,
    geos: Set<Str>,
    login_hours: Set<Int>,
}

entity Session {
    id: Str,
    user_id: Str,
    device_id: Str?,
    country: Str?,
    geo: Str?,
    mfa_present: Bool?,
    age: Duration?,
    trust_score: Float?,
    auth_method: Str?,
    active: Bool?,
}

entity FileEvent {
    path: Path,
    mode: Str?,
    process_id: Int?,
    inode: Int?,
    sensitivity_label: Str?,
    last_modified: Duration?,
}

entity NetworkFlow {
    process_id: Int?,
    session_id: Str?,
    secure_connect_session_id: Str?,
    direction: Str?,
    bytes_out: Int?,
    bytes_in: Int?,
    tunneled: Bool?,
    dest: NetworkEndpoint,
}

entity NetworkEndpoint {
    ip: IpAddr?,
    port: Int?,
    proto: Str?,
    is_internal: Bool?,
    threat_score: Float?,
    geo_country: Str?,
    asn: Str?,
    reputation: Str?,
    domain: Str?,
    is_secure_connect_gateway: Bool?,
    service_class: Str?,
}

entity DnsQuery {
    pid: Int,
    uid: Int,
    process_name: Str,
    // FNV-1a hash of the queried hostname.
    query_hash: Int,
    domain: DnsDomain,
}

entity DnsDomain {
    value: Str?,
    entropy: Float?,
}

entity ContainerContext {
    container_id: Str,
    pod_uid: Str?,
    exists: Bool,
    orchestrator: Str?,
    tags: Set<Str>,
    image: ContainerImage,
    labels: ContainerLabels,
    security: ContainerSecurity,
    namespaces: ContainerNamespaces,
    capabilities: ContainerCapabilities,
    initiator: InitiatorRef?,
}

entity ContainerImage {
    id: Str?,
    repo: Str?,
    tag: Str?,
}

entity ContainerLabels {
    environment: Str?,
}

entity ContainerSecurity {
    privileged: Bool,
}

entity ContainerNamespaces {
    host_pid: Bool,
    host_network: Bool,
    host_ipc: Bool,
}

entity ContainerCapabilities {
    added: Set<Str>,
}

entity InitiatorRef {
    user_id: Str?,
}

entity WorkloadInfo {
    pod_uid: Str?,
    namespace: Str?,
    name: Str?,
}

entity SecureConnectSession {
    id: Str,
    user_id: Str?,
    device_id: Str?,
    host_id: Str?,
    profile_id: Str?,
    gateway_id: Str?,
    peer_id: Str?,
    active: Bool,
    state: Str?,
    established: Bool?,
    age: Duration?,
    risk_score: Float?,
    mfa_bound: Bool?,
    route_mode: Str?,
    dns_mode: Str?,
    client_ip: IpAddr?,
    tunnel_ip: IpAddr?,
    country: Str?,
    geo: Str?,
    declared_scope: Str?,
}

entity Device {
    id: Str,
    hostname: Str?,
    serial: Str?,
    managed: Bool?,
    compliant: Bool?,
    trust_score: Float?,
    posture: DevicePosture,
}

entity DevicePosture {
    agent_healthy: Bool?,
    kernel_sensor: Bool?,
    disk_encryption: Bool?,
    screen_lock: Bool?,
    os_supported: Bool?,
    firewall_enabled: Bool?,
    edr_present: Bool?,
    last_seen_age: Duration?,
    risk_score: Float?,
}

entity SecureConnectProfile {
    id: Str,
    name: Str,
    mode: Str?,
    scope: Str?,
    allow_cidrs: Set<Str>,
    allow_domains: Set<Str>,
    allow_ports: Set<Int>,
    dns_servers: Set<IpAddr>,
    require_mfa: Bool?,
    require_managed_device: Bool?,
    require_compliant_device: Bool?,
    max_session_age: Duration?,
}

entity SecureConnectGateway {
    id: Str,
    name: Str?,
    region: Str?,
    hostname: Str?,
    public_ip: IpAddr?,
    internal_ip: IpAddr?,
    port: Int?,
    healthy: Bool?,
    environment: Str?,
}

entity SecureConnectPeer {
    id: Str,
    public_key: Str?,
    endpoint_ip: IpAddr?,
    endpoint_port: Int?,
    latest_handshake_age: Duration?,
    rx_bytes: Int?,
    tx_bytes: Int?,
}

// --- SQL database query events (uprobe on libpq / libmysqlclient) ------------

root db: SqlEvent

entity SqlEvent {
    pid: Int,
    uid: Int,
    process_name: Str,
    // Statement class — use numeric constants in rules:
    //   0 = other/unknown
    //   1 = SELECT  (read-only)
    //   2 = DML     (INSERT / UPDATE / DELETE / REPLACE)
    //   3 = DDL     (CREATE / DROP / ALTER / TRUNCATE)
    //   4 = ADMIN   (GRANT / REVOKE / SET / CALL / EXEC)
    query_class: Int,
    // FNV-1a hash of the first 128 bytes of query text.
    // Useful for allowlisting/blocklisting known queries.
    query_hash: Int,
    // Well-known port of the target database (5432 for PostgreSQL, 3306 for MySQL).
    db_port: Int,
    // Tables the statement touches, resolved from the *redacted* statement.
    // Literal values are stripped before names are read, so matching on a
    // table never exposes a value from the query.
    // Empty when the statement could not be parsed confidently, or when a
    // prepared statement executes without its prepare having been observed.
    tables: Set<Str>,
    // Database/schema the statement targets, when every qualified table
    // reference agrees on one. Null for a cross-database join.
    database: Str?,
}

// --- TLS/OpenSSL encryption events (uprobe on libssl) ------------------------

root ssl: SslEvent

entity SslEvent {
    pid: Int,
    uid: Int,
    process_name: Str,
    // Operation direction:
    //   0 = encrypt  (EVP_EncryptUpdate)
    //   1 = decrypt  (EVP_DecryptUpdate)
    operation: Int,
    // Number of input bytes processed in this single EVP call.
    // Correlate high sustained values with file writes to detect ransomware.
    data_len: Int,
}
