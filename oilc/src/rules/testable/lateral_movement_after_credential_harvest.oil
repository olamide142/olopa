// Credential access & lateral movement — credential file read, then outbound
// connection to an internal lateral-movement port (SSH, SMB, RDP, WinRM,
// Kube API), within 10 minutes.
//
// Manual test:
//   cargo run --manifest-path oilc/Cargo.toml -- \
//     --source oilc/src/rules/testable/lateral_movement_after_credential_harvest.oil --mode check
//
// To fire it: process_exec_events row joined by pid to (1) a file_events row
// with operation "read" and path matching credential_sources, and (2) a
// net_events row with direction "outbound" and dst_port in lateral_ports,
// both within 10m.

set lateral_ports = [22, 445, 3389, 5985, 5986, 2375, 6443]

set credential_sources = [
  "/root/.ssh/id_rsa",
  "/home/*/.ssh/id_rsa",
  "/etc/shadow",
  "~/.aws/credentials",
  "~/.kube/config"
]

set lateral_tools = [
  "ssh",
  "scp",
  "rsync",
  "psexec",
  "smbclient",
  "wmic",
  "curl",
  "nc",
  "python",
  "python3"
]

fact host.lateral_origin(host_id) expires 12h

rule "lateral_movement_after_credential_harvest" {
  from endpoint.file, endpoint.process, network.flow

  correlate
    file.open as f by process as p
    with network.connect as n on n.process_id == p.id

  where
    f.path matches credential_sources
    and n.dest.port in lateral_ports
    and n.direction == "outbound"

  within 10m

  let
    internal_target = n.dest.is_internal == true
    suspicious_tool = p.name in lateral_tools
    unusual_host = n.dest.ip not in host(p.host_id).baseline.ips
    privileged_user = p.uid == 0

  score
    65
    +15 if internal_target
    +10 if suspicious_tool
    +10 if unusual_host
    +10 if privileged_user

  emit
    fact host.lateral_origin(host.id) expires 12h

  respond
    if score >= 85 {
      alert critical
      isolate host
      snapshot p, f, n
      open case "Credential harvesting followed by internal lateral movement"
    } else {
      alert high
      snapshot p, f
    }
}
