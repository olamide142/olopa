// Secure Connect gateway — a connection attempt to a Secure Connect gateway
// IP while its session is inactive: possible unauthorized tunnel bootstrap.
//
// Manual test:
//   cargo run --manifest-path oilc/Cargo.toml -- \
//     --source oilc/src/rules/testable/unexpected_secure_connect_gateway_access.oil --mode check
//
// This rule can only be FIRED via the agent's local RuntimeIrRuleEngine
// (agent/agent/src/runtime_ir.rs) — the ingest server's correlation engine
// has no secure_connect.* event source or field support. See the Rust unit
// test in agent/agent/src/agent.rs for a manual-equivalent fixture you can
// run with `cargo test -p olopa-agent`.

set secure_connect_gateways = ["10.10.0.1", "10.10.0.2"]

rule "unexpected_secure_connect_gateway_access" {
    from network.connect as n, secure_connect.session as sc

    correlate network.connect as n with secure_connect.session as sc by user_id

    where
        n.dest.ip in secure_connect_gateways
        and sc.active == false

    score 80
        +20 if n.direction == "outbound"

    respond
        alert critical "Unexpected connection attempt to Secure Connect gateway"
        snapshot host.timeline, process.tree(n.pid)
        open_case "Possible unauthorized tunnel bootstrap"
        notify "SOC page now"
}
