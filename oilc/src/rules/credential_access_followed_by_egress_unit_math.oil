set credential_targets_unit_math = [
  "/etc/shadow",
  "/root/.ssh/id_rsa",
  "/home/*/.ssh/id_rsa",
  "~/.aws/credentials",
  "~/.kube/config"
]

rule "credential_access_followed_by_egress_unit_math" {
  from endpoint.file, endpoint.process, network.flow

  correlate
    file.open as f by process as p
    with network.connect as n on n.process_id == p.id

  where
    f.path matches credential_targets_unit_math
    and n.direction == "outbound"
    and (n.bytes_out / 1024) > 500

  within 10m

  score
    65
    +15 if (n.bytes_out / 1024) > 1000

  respond
    if (score + 5) >= 85 {
      alert critical
    } else {
      alert high
    }
}
