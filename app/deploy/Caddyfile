{
	auto_https off
}

:80 {
	encode zstd gzip

	# Optional direct ingress to Rust ingest server:
	#   http://localhost/ingest/health -> http://olopa-ingest:8000/health
	handle /ingest/* {
		uri strip_prefix /ingest
		reverse_proxy olopa-ingest:8000
	}

	# Optional access to Keycloak behind the same gateway:
	#   http://localhost/keycloak/ -> http://keycloak:8080/
	handle /keycloak/* {
		uri strip_prefix /keycloak
		reverse_proxy keycloak:8080
	}

	# Default app traffic:
	#   /, /app, /health, /api/v1/* -> control-plane
	handle {
		reverse_proxy control-plane:8100
	}
}
