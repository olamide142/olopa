{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Olopa Command",
  "version": "0.1.0",
  "identifier": "io.olopa.command",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Olopa Command",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Olopa operator workstation",
    "longDescription": "Manage the Olopa agent, author and simulate OIL policy, inspect eBPF programs, observe kernel telemetry and control Secure Connect."
  }
}
