{
	auto_https off
}

:{$PORT} {
	encode zstd gzip

	# install.olopa.io routes into the in-app install panel.
	@install_downloads {
		host install.olopa.io
		path /downloads/* /install.sh /health
	}
	handle @install_downloads {
		reverse_proxy 127.0.0.1:8100
	}

	@install_root {
		host install.olopa.io
		path /
	}
	redir @install_root /install.sh 308

	@install_host host install.olopa.io
	redir @install_host https://console.olopa.io/app#install 308

	# Keep Railway healthchecks working.
	@health path /health
	handle @health {
		reverse_proxy 127.0.0.1:8100
	}

	# Landing page assets (mascot, etc).
	@assets path /assets/*
	handle @assets {
		reverse_proxy 127.0.0.1:8100
	}

	# Route console/API traffic to console subdomain.
	@console path /app /app/*
	redir @console https://console.olopa.io/app 308

	@api path /api/* /docs /openapi.json
	redir @api https://console.olopa.io{uri} 308

	# Serve landing page at root.
	@root path /
	handle @root {
		reverse_proxy 127.0.0.1:8100
	}

	# Everything else collapses to landing root.
	handle {
		redir / 308
	}
}
