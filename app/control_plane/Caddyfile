{
	auto_https off
}

:{$PORT} {
	encode zstd gzip

	@console_host host console.olopa.io
	handle @console_host {
		reverse_proxy 127.0.0.1:8100
	}


	@docs_root {
		host docs.olopa.io
		path /
	}
	redir @docs_root /quickstart 308

	@docs_pages {
		host docs.olopa.io
		path /quickstart /quickstart/* /agent/config /agent/config/*
	}
	handle @docs_pages {
		reverse_proxy 127.0.0.1:8100
	}

	@docs_assets {
		host docs.olopa.io
		path /assets/*
	}
	handle @docs_assets {
		reverse_proxy 127.0.0.1:8100
	}

	@docs_other host docs.olopa.io
	handle @docs_other {
		redir /quickstart 308
	}

	@landing_health {
		host olopa.io www.olopa.io
		path /health
	}
	handle @landing_health {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_assets {
		host olopa.io www.olopa.io
		path /assets/*
	}
	handle @landing_assets {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_install_script {
		host olopa.io www.olopa.io
		path /install.sh
	}
	handle @landing_install_script {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_console {
		host olopa.io www.olopa.io
		path /app /app/*
	}
	redir @landing_console https://console.olopa.io/ 308

	@landing_api {
		host olopa.io www.olopa.io
		path /api/* /docs /openapi.json
	}
	redir @landing_api https://console.olopa.io{uri} 308

	@landing_root {
		host olopa.io www.olopa.io
		path /
	}
	handle @landing_root {
		rewrite * /landing
		reverse_proxy 127.0.0.1:8100
	}

	@landing_other host olopa.io www.olopa.io
	handle @landing_other {
		redir / 308
	}

	reverse_proxy 127.0.0.1:8100
}
