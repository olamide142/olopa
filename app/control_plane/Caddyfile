{
	auto_https off
}

:{$PORT} {
	encode zstd gzip

	@console_host host console.olopa.io
	handle @console_host {
		reverse_proxy 127.0.0.1:8100
	}

	@releases_install {
		host releases.olopa.io
		path /install.sh /latest/install.sh
	}
	handle @releases_install {
		rewrite * /install.sh
		reverse_proxy 127.0.0.1:8100
	}

	@releases_host host releases.olopa.io
	handle @releases_host {
		root * /opt/olopa/app/control_plane/releases
		@releases_root path /
		rewrite @releases_root /latest/index.html
		file_server
	}

	@landing_health {
		host olopa.io www.olopa.io
		path /health
	}
	handle @landing_health {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_assets {
		host olopa.io www.olopa.io
		path /assets/*
	}
	handle @landing_assets {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_console {
		host olopa.io www.olopa.io
		path /app /app/*
	}
	redir @landing_console https://console.olopa.io/ 308

	@landing_api {
		host olopa.io www.olopa.io
		path /api/* /docs /openapi.json
	}
	redir @landing_api https://console.olopa.io{uri} 308

	@landing_root {
		host olopa.io www.olopa.io
		path /
	}
	handle @landing_root {
		rewrite * /landing
		reverse_proxy 127.0.0.1:8100
	}

	@landing_other host olopa.io www.olopa.io
	handle @landing_other {
		redir / 308
	}

	reverse_proxy 127.0.0.1:8100
}
