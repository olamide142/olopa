{
	auto_https off
}

:{$PORT} {
	encode zstd gzip

	# ---- console.olopa.io — FastAPI dashboard (React SPA) + control-plane APIs ----
	@console_host host console.olopa.io
	handle @console_host {
		reverse_proxy 127.0.0.1:8100
	}

	# ---- docs.olopa.io — fully static docs site, no backend involved ----
	@docs_root {
		host docs.olopa.io
		path /
	}
	redir @docs_root /quickstart/ 308

	@docs_host host docs.olopa.io
	handle @docs_host {
		root * /srv/site
		file_server
	}

	# ---- olopa.io / www.olopa.io — static landing, plus the couple of routes
	# that still need the backend (agent download resolves env config at
	# runtime; health checks control-plane state) ----
	@landing_install {
		host olopa.io www.olopa.io
		path /install
	}
	redir @landing_install /#install 307

	@landing_downloads {
		host olopa.io www.olopa.io
		path /downloads/agent/latest
	}
	handle @landing_downloads {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_health {
		host olopa.io www.olopa.io
		path /health
	}
	handle @landing_health {
		reverse_proxy 127.0.0.1:8100
	}

	@landing_console {
		host olopa.io www.olopa.io
		path /app /app/*
	}
	redir @landing_console https://console.olopa.io/ 308

	@landing_api {
		host olopa.io www.olopa.io
		path /api/* /docs /openapi.json
	}
	redir @landing_api https://console.olopa.io{uri} 308

	@landing_host host olopa.io www.olopa.io
	handle @landing_host {
		root * /srv/site
		file_server
	}

	reverse_proxy 127.0.0.1:8100
}
